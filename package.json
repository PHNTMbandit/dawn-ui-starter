{
  "name": "ixia-starter",
  "version": "1.0.0",
  "private": false,
  "description": "A full-stack React 19 starter built with TanStack Start, using Vite+ as its toolchain and Ixia UI for components. Includes Better Auth, Drizzle ORM, theming, and English/Japanese internationalization.",
  "keywords": [
    "better-auth",
    "drizzle-orm",
    "internationalization",
    "ixia-ui",
    "react",
    "react-starter",
    "starter-template",
    "tailwindcss",
    "tanstack-start",
    "vite-plus"
  ],
  "homepage": "https://github.com/PHNTMbandit/ixia-starter#readme",
  "bugs": {
    "url": "https://github.com/PHNTMbandit/ixia-starter/issues"
  },
  "license": "MIT",
  "author": "PHNTMbandit",
  "repository": {
    "type": "git",
    "url": "https://github.com/PHNTMbandit/ixia-starter.git"
  },
  "funding": "https://github.com/sponsors/PHNTMbandit",
  "type": "module",
  "scripts": {
    "build-storybook": "storybook build",
    "commit": "git add . && git commit",
    "cz": "cz",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "storybook": "concurrently 'pnpm:watch:*'",
    "watch:storybook": "storybook dev -p 6006",
    "watch:tailwind": "pnpx @tailwindcss/cli -i ./src/styles/input.css -o ./src/styles/output.css --watch"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@daypicker/react": "^10.0.2",
    "@faker-js/faker": "^10.6.0",
    "@inlang/paraglide-js-react": "^1.0.3",
    "@neondatabase/serverless": "^1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-themes": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/match-sorter-utils": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-form-start": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.14.3",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "1.169.2",
    "@tanstack/react-table": "latest",
    "@tanstack/react-virtual": "^3.14.20",
    "@tanstack/router-plugin": "^1.168.46",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "^0.45.4",
    "ixia-ui-react": "1.0.2",
    "nitro": "3.0.260903-beta",
    "oxc-transform-react": "^0.154.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "shiki": "^4.5.0",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "webfontloader": "^1.6.28",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@inlang/paraglide-js": "^2.29.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-plugin-query": "^5.104.3",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webfontloader": "^1.6.38",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "catalog:",
    "commitizen": "^4.3.2",
    "concurrently": "^10.0.6",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^18.0.8",
    "jsdom": "^30.1.3",
    "oxlint-tailwindcss": "^1.16.0",
    "playwright": "^1.64.1",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-conventional-changelog"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  }
}
